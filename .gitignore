# The render fixture is exported from the live site and contains its content.
# Regenerate it with tests/export-fixture.py; never commit it.
tests/fixture.json
tests/.db.json

# The synthetic fixture is generated by tests/make-fixture.php, which IS committed. Keeping
# only the generator in git is deliberate: a generated artifact checked in beside the thing
# that generates it drifts, and the drift is silent because both look plausible. Rebuild it
# with `php tests/make-fixture.php` -- it is deterministic, so two rebuilds are byte-identical.
tests/fixture-synthetic.json

# Local preview output.
preview.html

.DS_Store
node_modules/
__pycache__/
*.log

# Scratch worktrees and local tool state.
.claude/
docs/reviews/

# Deploy target. The host and account are credentials-adjacent -- an FTP hostname plus its
# username is two thirds of a login -- and this repository is public, so they live here and
# never in tools/deploy.sh. The password is in the macOS login keychain, not in this file.
tools/deploy.env

# Machine-local notes about the deployment target -- the hosting shape, the stack versions, and
# the inventory of Envira leftovers on the live site. Same reasoning as the line above: no single
# fact is a credential, and together they describe one named site's hosting. AGENTS.md and TODO.md
# point at this file; nothing breaks in a clone that does not have it.
AGENTS.local.md
