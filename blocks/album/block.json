{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lichtbild/album",
	"title": "Lichtbild Album",
	"category": "media",
	"icon": "format-image",
	"description": "Places an existing Lichtbild album in the post.",
	"keywords": [ "album", "galleries", "envira" ],
	"textdomain": "lichtbild-gallery",
	"attributes": {
		"id": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"multiple": true,
		"reusable": true
	},
	"editorScript": "lichtbild-blocks",
	"editorStyle": "lichtbild-blocks"
}
