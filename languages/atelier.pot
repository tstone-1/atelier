#: includes/class-atelier-migration-screen.php:332
msgid "Galleries are still stored the way Envira wrote them. Atelier reads them in place, so nothing needs to change — but while that is true, uninstalling Envira would take the gallery, album and tag URLs off the site along with it."
msgstr ""

#: includes/class-atelier-migration-screen.php:335
msgid "Migrating moves the galleries onto Atelier's own post types. What it does:"
msgstr ""

#. translators: 1: galleries, 2: albums, 3: image tags.
#: includes/class-atelier-migration-screen.php:342
#, php-format
msgid "Renames %1$d galleries, %2$d albums and %3$d image tags to Atelier's types, in place. Post IDs do not change, so every [envira-gallery id=\"…\"] shortcode keeps working."
msgstr ""

#. translators: 1: convertible galleries, 2: Envira's defaults record count.
#: includes/class-atelier-migration-screen.php:353
#, php-format
msgid "Converts %1$d gallery records into Atelier's own format. %2$d are Envira's stored defaults rather than galleries and are skipped."
msgstr ""

#: includes/class-atelier-migration-screen.php:359
msgid "Keeps every URL exactly as it is. /envira/, /envira_album/ and /envira-tag/ continue to work and are still canonical."
msgstr ""

#: includes/class-atelier-migration-screen.php:360
msgid "Leaves Envira's own records untouched, so this can be reversed from this screen."
msgstr ""

#. translators: %d: number of galleries with no readable record.
#: includes/class-atelier-migration-screen.php:368
#, php-format
msgid "%d gallery has no readable record. It will be renamed but not converted, and will render as empty."
