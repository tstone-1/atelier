msgstr "https://github.com/tstone-1/atelier"

#. Description of the plugin
#: atelier.php
msgid ""
"Responsive galleries for WordPress. Reads existing Envira Gallery data in "
"place, so galleries keep working without migration or a licence."
msgstr "Responsive Galerien für WordPress. Liest vorhandene Daten von Envira Gallery direkt aus, sodass Galerien ohne Migration und ohne Lizenz weiterlaufen."

#. Author of the plugin
#: atelier.php
msgid "tstone-1"
msgstr "tstone-1"

